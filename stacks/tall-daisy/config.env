# TALL Stack + daisyUI Configuration
# Tailwind + Alpine + Laravel + Livewire + daisyUI

STACK_NAME="tall-daisy"

# Component paths
COMPONENT_PATH="app/Livewire"
COMPONENT_NAMESPACE="App\\Livewire"
VIEW_PATH="resources/views/livewire"

# Model paths
MODEL_PATH="app/Models"
MODEL_NAMESPACE="App\\Models"

# Database paths
MIGRATION_PATH="database/migrations"
SEEDER_PATH="database/seeders"
SEEDER_NAMESPACE="Database\\Seeders"

# Backend paths
ACTION_PATH="app/Actions"
ACTION_NAMESPACE="App\\Actions"
EVENT_PATH="app/Events"
EVENT_NAMESPACE="App\\Events"
JOB_PATH="app/Jobs"
JOB_NAMESPACE="App\\Jobs"
COMMAND_PATH="app/Console/Commands"
COMMAND_NAMESPACE="App\\Console\\Commands"
SCHEDULE_FILE="routes/console.php"

# Test paths
TEST_PATH="tests/Feature/Livewire"

# UI Framework
UI_FRAMEWORK="daisyUI"
JS_FRAMEWORK="Alpine.js"

# Language Settings
UI_LANGUAGE="ja"           # UI text: labels, buttons, messages (ja, en, etc.)
COMMENT_LANGUAGE="ja"      # Code comments (ja, en, etc.)
