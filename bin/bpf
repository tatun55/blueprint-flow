#!/bin/bash
# Blueprint Flow v2 CLI
# Usage: bpf <command> [args]

set -euo pipefail

# ============================================
# Configuration Resolution
# Priority: env var > ~/.bpfrc > default
# ============================================
load_config() {
    local rc="$HOME/.bpfrc"
    if [[ -f "$rc" ]]; then
        # Source only KEY=VALUE lines (ignore comments and empty lines)
        while IFS='=' read -r key value; do
            [[ -z "$key" || "$key" =~ ^# ]] && continue
            key=$(echo "$key" | tr -d '[:space:]')
            value=$(echo "$value" | tr -d '[:space:]' | sed 's/^["'"'"']//;s/["'"'"']$//')
            export "${key}=${!key:-$value}" 2>/dev/null || true
        done < "$rc"
    fi
}
load_config

BPF_HOME="${BPF_HOME:-$HOME/.blueprint-flow}"
BPF_PROJECT_BASE="${BPF_PROJECT_BASE:-$HOME/project}"
BPF_VALET_DOMAIN="${BPF_VALET_DOMAIN:-pizza}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info()    { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[OK]${NC} $1"; }
log_warn()    { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error()   { echo -e "${RED}[ERROR]${NC} $1"; }

# Check BPF_HOME exists
if [[ ! -d "$BPF_HOME" ]]; then
    log_error "Blueprint Flow not found at: $BPF_HOME"
    echo ""
    echo "Install with:"
    echo "  git clone https://github.com/tatun55/blueprint-flow ~/.blueprint-flow"
    echo ""
    echo "Or set BPF_HOME in ~/.bpfrc or as env var:"
    echo "  echo 'BPF_HOME=/path/to/blueprint-flow' >> ~/.bpfrc"
    exit 1
fi

# ============================================
# DB helpers
# ============================================
DB_PATH="blueprint/blueprint.db"
SCHEMA_PATH="blueprint/schema.sql"

get_stack() {
    if [[ -f ".blueprint-flow-stack" ]]; then
        cat ".blueprint-flow-stack"
    else
        echo ""
    fi
}

get_rules_dir() {
    local stack
    stack=$(get_stack)
    if [[ -z "$stack" ]]; then return; fi
    local dir="$BPF_HOME/.claude.$stack/rules"
    if [[ -d "$dir" ]]; then
        echo "$dir"
    fi
}

seed_rules() {
    local rules_dir
    rules_dir=$(get_rules_dir)
    if [[ -z "$rules_dir" ]]; then
        echo "No rules directory found"
        return
    fi

    local hub="python3 $BPF_HOME/blueprint/hub.py"
    local count=0
    for file in "$rules_dir"/*.md; do
        [[ -f "$file" ]] || continue
        local slug
        slug=$(basename "$file" .md)
        local name
        name=$(head -1 "$file" | sed 's/^# //')
        local summary
        summary=$(sed -n '2p' "$file" | sed 's/^> //')

        $hub upsert-core tech "rules-$slug" "$name" "$summary" < "$file" > /dev/null
        count=$((count + 1))
    done
    echo "Seeded $count rule(s) from: $rules_dir"
}

# v3 では knowledge_sets テーブルは撤去。type→rules マッピングは hub.py 内の Python dict (TYPE_RULES) に集約済み。

db_migrate() {
    # Run schema migrations for existing databases
    # Each migration checks before applying (idempotent)
    # NOTE: V2→V3 の破壊的移行は db_migrate_v3() を使う

    # Always use latest schema from BPF_HOME
    cp "$BPF_HOME/blueprint/schema.sql" "$SCHEMA_PATH"

    # v3 では all view を毎回作り直し（schema.sql の IF NOT EXISTS で冪等）
    sqlite3 "$DB_PATH" << 'MIGRATE_EOF'
DROP VIEW IF EXISTS active_blueprints;
DROP VIEW IF EXISTS app_snapshot;
DROP VIEW IF EXISTS project_progress;
DROP VIEW IF EXISTS item_status;
DROP VIEW IF EXISTS next_actions;
DROP VIEW IF EXISTS attention_needed;
DROP VIEW IF EXISTS dependency_map;
DROP VIEW IF EXISTS task_board;
DROP VIEW IF EXISTS test_coverage;
MIGRATE_EOF
    sqlite3 "$DB_PATH" < "$SCHEMA_PATH"
    log_success "VIEWs recreated"
}

db_migrate_v3() {
    # V2 → V3 破壊的マイグレーション
    # - cores: stage / stage_dirty カラム追加
    # - blueprints: テーブル再作成 (CHECK + UNIQUE を v3 に、step→step_status 縮約)
    # - dependencies.dep_gate: test_l*→test / seed→define
    # - stage_transitions / review_decisions テーブル新設
    # - knowledge_sets テーブル drop (Wave 1c 前倒し)
    # - v2 の test_level / step / parent_id カラム drop (Wave 1c 前倒し)
    if [[ ! -f "$DB_PATH" ]]; then
        log_error "No DB at $DB_PATH — run 'bpf db init' for a fresh v3 schema"
        return 1
    fi

    # v3 detection: cores.stage column の有無で判定
    local has_stage
    has_stage=$(sqlite3 "$DB_PATH" "SELECT COUNT(*) FROM pragma_table_info('cores') WHERE name='stage';")
    if [[ "$has_stage" != "0" ]]; then
        log_info "DB is already v3 (cores.stage exists) — skipping"
        return 0
    fi

    # Backup
    local backup="${DB_PATH}.v2-backup-$(date +%Y%m%d-%H%M%S)"
    cp "$DB_PATH" "$backup"
    log_success "Backup: $backup"

    # 最新 schema を取得しておく
    cp "$BPF_HOME/blueprint/schema.sql" "$SCHEMA_PATH"

    # Phase 1: テーブル変換（views/indexes は後で schema.sql から再作成）
    # .bail on でエラー時に即停止 → BEGIN 中の未 COMMIT 変更は破棄される
    sqlite3 "$DB_PATH" << 'MIGRATE_V3_EOF'
.bail on
BEGIN TRANSACTION;

-- 1. cores: stage / stage_dirty 追加
ALTER TABLE cores ADD COLUMN stage TEXT NOT NULL DEFAULT 'proto'
    CHECK(stage IN ('proto','mvp','beta','prod','prod_reviewed'));
ALTER TABLE cores ADD COLUMN stage_dirty INTEGER NOT NULL DEFAULT 0;

-- 2. blueprints: CHECK + UNIQUE を v3 にするため再作成
CREATE TABLE blueprints_v3 (
    id                  INTEGER PRIMARY KEY AUTOINCREMENT,
    type                TEXT NOT NULL,
    slug                TEXT NOT NULL,
    name                TEXT NOT NULL,
    summary             TEXT NOT NULL,
    content             TEXT NOT NULL,
    step_status         TEXT NOT NULL DEFAULT 'define'
                        CHECK(step_status IN ('define','impl','test','done')),
    stage               TEXT NOT NULL DEFAULT 'proto'
                        CHECK(stage IN ('proto','mvp','beta','prod')),
    -- FK は省略 (SQLite の自己参照 FK + ALTER RENAME 不整合のため。schema.sql 注釈参照)
    parent_blueprint_id INTEGER,
    frozen              INTEGER NOT NULL DEFAULT 0,
    reviewed            BOOLEAN DEFAULT 0,
    locked_by           TEXT,
    dirty               BOOLEAN DEFAULT 0,
    dirty_reason        TEXT,
    updated_at          DATETIME DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(type, stage, slug, frozen)
);

-- 値変換コピー: step → step_status (test_l*→test, seed→define)
-- v2 には reviewed カラムがない → v3 の DEFAULT 0 に任せる
INSERT INTO blueprints_v3
    (id, type, slug, name, summary, content,
     step_status, stage, parent_blueprint_id, frozen,
     locked_by, dirty, dirty_reason, updated_at)
SELECT
    id, type, slug, name, summary, content,
    CASE step
        WHEN 'define'  THEN 'define'
        WHEN 'seed'    THEN 'define'
        WHEN 'impl'    THEN 'impl'
        WHEN 'test_l1' THEN 'test'
        WHEN 'test_l2' THEN 'test'
        WHEN 'test_l3' THEN 'test'
        WHEN 'done'    THEN 'done'
        ELSE 'define'
    END,
    'proto', NULL, 0,
    locked_by, dirty, dirty_reason, updated_at
FROM blueprints;

-- 旧 blueprints を drop して RENAME（FK は views 経由で参照されているだけなのでこの順で OK）
-- dependencies は source_id/target_id で blueprints を参照しているが、ID は保持されるので問題なし
DROP TABLE blueprints;
ALTER TABLE blueprints_v3 RENAME TO blueprints;

-- 3. dependencies.dep_gate: 旧値を v3 値に縮約
UPDATE dependencies SET dep_gate = 'test'   WHERE dep_gate IN ('test_l1','test_l2','test_l3');
UPDATE dependencies SET dep_gate = 'define' WHERE dep_gate = 'seed';

-- 4. v3 新設テーブル
CREATE TABLE stage_transitions (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    core_id     INTEGER NOT NULL REFERENCES cores(id),
    from_stage  TEXT NOT NULL,
    to_stage    TEXT NOT NULL,
    reviewed_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    notes       TEXT
);

CREATE TABLE review_decisions (
    id            INTEGER PRIMARY KEY AUTOINCREMENT,
    act_id        INTEGER,
    blueprint_id  INTEGER,
    runner        TEXT NOT NULL,
    decision_type TEXT NOT NULL,
    trigger       TEXT NOT NULL,
    mode          TEXT,
    score         INTEGER NOT NULL,
    threshold     INTEGER NOT NULL,
    asked_human   INTEGER NOT NULL,
    outcome       TEXT NOT NULL,
    reason        TEXT NOT NULL,
    raw_emit      TEXT,
    created_at    DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- 5. Wave 1c 前倒し: knowledge_sets drop（v3 では Python dict で代替）
DROP TABLE IF EXISTS knowledge_sets;

-- 6. v2 view を全部 drop（schema.sql で v3 view を CREATE する）
DROP VIEW IF EXISTS app_snapshot;
DROP VIEW IF EXISTS project_progress;
DROP VIEW IF EXISTS item_status;
DROP VIEW IF EXISTS next_actions;
DROP VIEW IF EXISTS attention_needed;
DROP VIEW IF EXISTS dependency_map;
DROP VIEW IF EXISTS task_board;
DROP VIEW IF EXISTS test_coverage;
DROP VIEW IF EXISTS active_blueprints;

COMMIT;
MIGRATE_V3_EOF

    if [[ $? -ne 0 ]]; then
        log_error "Migration failed. Restore with: cp $backup $DB_PATH"
        return 1
    fi

    # Phase 2: schema.sql 流し込みで v3 views / indexes / triggers を作成
    # CREATE INDEX / CREATE VIEW / CREATE TRIGGER は IF NOT EXISTS、CREATE TABLE は既存スキップ
    sqlite3 "$DB_PATH" < "$SCHEMA_PATH"

    log_success "Migrated to V3 schema"
    echo "  Backup: $backup"
    echo "  Restore: cp $backup $DB_PATH"
}

db_init() {
    mkdir -p "$(dirname "$DB_PATH")"
    if [[ -f "$DB_PATH" ]]; then
        db_migrate
        echo "Database migrated: $DB_PATH"
    else
        sqlite3 "$DB_PATH" < "$SCHEMA_PATH"
        echo "Database initialized: $DB_PATH"
    fi
    seed_rules
}

db_reset() {
    rm -f "$DB_PATH"
    sqlite3 "$DB_PATH" < "$SCHEMA_PATH"
    echo "Database reset: $DB_PATH"
    seed_rules
}

# ============================================
# Symlink helpers
# ============================================
create_bpf_symlink() {
    local target_dir="${1:-.}"
    # Create .blueprint-flow symlink pointing to BPF_HOME
    if [[ -L "$target_dir/.blueprint-flow" ]]; then
        rm "$target_dir/.blueprint-flow"
    fi
    ln -sf "$BPF_HOME" "$target_dir/.blueprint-flow"
}

create_claude_symlinks() {
    local target_dir="${1:-.}"
    local stack="${2}"
    local relative_bpf=".blueprint-flow"

    # Ensure .claude is a real directory (not a symlink)
    if [[ -L "$target_dir/.claude" ]]; then
        rm "$target_dir/.claude"
    fi
    mkdir -p "$target_dir/.claude"

    for item in skills agents hooks CLAUDE.md settings.json; do
        local src="../$relative_bpf/.claude.$stack/$item"
        if [[ -e "$BPF_HOME/.claude.$stack/$item" ]]; then
            ln -sfn "$src" "$target_dir/.claude/$item"
        fi
    done
}

# ============================================
# Commands
# ============================================

cmd_init() {
    local stack="${1:-tall-daisy}"
    local target_dir="."

    log_info "Initializing blueprint-flow v2 with stack: $stack"

    # Validate stack
    if [[ ! -d "$BPF_HOME/.claude.$stack" ]]; then
        log_error "Stack '$stack' not found"
        echo "Available stacks:"
        ls -1 "$BPF_HOME" | grep "^\.claude\." | sed 's/^\.claude\./  /'
        exit 1
    fi

    # Step 1: Create .blueprint-flow symlink
    create_bpf_symlink "$target_dir"
    log_success ".blueprint-flow -> $BPF_HOME"

    # Step 2: Create .claude symlinks
    create_claude_symlinks "$target_dir" "$stack"
    log_success ".claude/ symlinks created"

    # Step 3: Create blueprint directory + copy schema
    mkdir -p "$target_dir/blueprint"
    cp "$BPF_HOME/blueprint/schema.sql" "$target_dir/blueprint/"
    log_success "Schema copied"

    # Step 4: Store stack + version
    echo "$stack" > "$target_dir/.blueprint-flow-stack"
    git -C "$BPF_HOME" rev-parse HEAD 2>/dev/null > "$target_dir/.blueprint-flow-version" || echo "dev" > "$target_dir/.blueprint-flow-version"

    # Step 5: Initialize DB
    db_init

    # Step 6: Create minimal CLAUDE.md if not exists
    if [[ ! -f "$target_dir/CLAUDE.md" ]]; then
        cat > "$target_dir/CLAUDE.md" << 'CLAUDE_EOF'
# Project Rules

## Blueprint Flow

This project uses blueprint-flow.
Core rules are defined in `.claude/CLAUDE.md` (always loaded).

Use `/bpf` for orchestration.

## Project-Specific Rules

(Add project-specific rules here)
CLAUDE_EOF
        log_success "CLAUDE.md created"
    fi

    # Add to .gitignore
    if [[ -f "$target_dir/.gitignore" ]] && ! grep -q "^\.blueprint-flow$" "$target_dir/.gitignore" 2>/dev/null; then
        echo ".blueprint-flow" >> "$target_dir/.gitignore"
        log_success "Added .blueprint-flow to .gitignore"
    fi

    echo ""
    log_success "Blueprint-flow v2 initialized!"
    echo "  Stack: $stack"
    echo "  BPF_HOME: $BPF_HOME"
}

cmd_update() {
    local target_dir="."

    if [[ ! -f "$target_dir/.blueprint-flow-stack" ]]; then
        log_error "Project not initialized. Run: bpf init [stack]"
        exit 1
    fi

    local stack
    stack=$(cat "$target_dir/.blueprint-flow-stack")
    local old_version
    old_version=$(cat "$target_dir/.blueprint-flow-version" 2>/dev/null || echo "unknown")

    log_info "Updating blueprint-flow v2..."

    # Validate stack
    if [[ ! -d "$BPF_HOME/.claude.$stack" ]]; then
        log_error "Stack '$stack' not found in $BPF_HOME"
        exit 1
    fi

    # Update .blueprint-flow symlink
    create_bpf_symlink "$target_dir"
    log_success ".blueprint-flow -> $BPF_HOME"

    # Update .claude symlinks
    create_claude_symlinks "$target_dir" "$stack"
    log_success ".claude/ symlinks updated"

    # Update schema
    cp "$BPF_HOME/blueprint/schema.sql" "$target_dir/blueprint/"
    log_success "Schema updated"

    # Update version
    local new_version
    new_version=$(git -C "$BPF_HOME" rev-parse HEAD 2>/dev/null || echo "dev")
    echo "$new_version" > "$target_dir/.blueprint-flow-version"

    echo ""
    log_success "Blueprint-flow v2 updated!"
    echo "  Old: ${old_version:0:7}"
    echo "  New: ${new_version:0:7}"
    echo ""
    echo "Note: Database preserved. If schema changed, run: bpf db reset"
}

cmd_create_project() {
    # Parse flags
    local project_name=""
    local stack=""
    local project_type="laravel"  # laravel | extension

    for arg in "$@"; do
        case "$arg" in
            --extension) project_type="extension" ;;
            --stack=*)   stack="${arg#--stack=}" ;;
            -*)          log_error "Unknown option: $arg"; exit 1 ;;
            *)           project_name="$arg" ;;
        esac
    done

    # Default stack per type
    if [[ -z "$stack" ]]; then
        case "$project_type" in
            extension) stack="chrome-extension" ;;
            *)         stack="tall-daisy" ;;
        esac
    fi

    if [[ -z "$project_name" ]]; then
        echo "Usage: bpf create-project <project-name> [--extension] [--stack=<stack>]"
        exit 1
    fi

    local project_path="$BPF_PROJECT_BASE/$project_name"

    if [[ -d "$project_path" ]]; then
        log_error "Project already exists: $project_path"
        exit 1
    fi

    case "$project_type" in
        extension) _create_extension_project "$project_name" "$project_path" "$stack" ;;
        *)         _create_laravel_project   "$project_name" "$project_path" "$stack" ;;
    esac
}

_create_laravel_project() {
    local project_name="$1"
    local project_path="$2"
    local stack="$3"

    log_info "Creating project: $project_name"
    log_info "Path: $project_path"
    log_info "Stack: $stack"
    echo ""

    # Step 1: Create Laravel project
    log_info "Step 1: Creating Laravel project..."
    cd "$BPF_PROJECT_BASE"
    composer create-project laravel/laravel "$project_name" --quiet
    cd "$project_path"
    log_success "Laravel project created"

    # Step 2: Install dependencies
    log_info "Step 2: Installing dependencies..."
    composer require livewire/livewire --quiet
    log_success "Livewire installed"

    npm install --silent
    npm install -D tailwindcss @tailwindcss/vite daisyui --silent
    log_success "Tailwind + daisyUI installed"

    # Step 3: Configure environment
    log_info "Step 3: Configuring environment..."

    local db_pass=""
    if [[ -f ~/.my.cnf ]]; then
        db_pass=$(awk -F= '/^password/ {gsub(/"/,"",$2); print $2}' ~/.my.cnf | tr -d ' ' || echo "")
    fi

    cp .env.example .env
    sed -i '' "s|^APP_URL=.*|APP_URL=http://${project_name}.${BPF_VALET_DOMAIN}|" .env
    sed -i '' "s|^DB_CONNECTION=.*|DB_CONNECTION=mysql|" .env
    sed -i '' "s|^# DB_HOST=.*|DB_HOST=127.0.0.1|" .env
    sed -i '' "s|^# DB_PORT=.*|DB_PORT=3306|" .env
    sed -i '' "s|^# DB_DATABASE=.*|DB_DATABASE=${project_name}|" .env
    sed -i '' "s|^# DB_USERNAME=.*|DB_USERNAME=root|" .env
    sed -i '' "s|^# DB_PASSWORD=.*|DB_PASSWORD='${db_pass}'|" .env

    mysql -e "CREATE DATABASE IF NOT EXISTS \`${project_name}\`;"
    log_success "Database created: ${project_name}"

    php artisan key:generate --quiet
    log_success "App key generated"

    php artisan migrate --quiet
    log_success "Migrations completed"

    # Step 4: Configure Tailwind 4 + Vite
    log_info "Step 4: Configuring Tailwind..."

    cat > tailwind.config.js << 'EOF'
import daisyui from 'daisyui'

/** @type {import('tailwindcss').Config} */
export default {
  content: [
    "./resources/**/*.blade.php",
    "./resources/**/*.js",
    "./app/Livewire/**/*.php",
  ],
  plugins: [daisyui],
  daisyui: {
    themes: ["light", "dark"],
  },
}
EOF

    cat > resources/css/app.css << 'EOF'
@import "tailwindcss";
@config "../../tailwind.config.js";
EOF

    cat > vite.config.js << 'EOF'
import { defineConfig } from 'vite';
import laravel from 'laravel-vite-plugin';
import tailwindcss from '@tailwindcss/vite';

export default defineConfig({
    plugins: [
        laravel({
            input: ['resources/css/app.css', 'resources/js/app.js'],
            refresh: true,
        }),
        tailwindcss(),
    ],
});
EOF
    log_success "Tailwind configured"

    # Step 5: Initialize Git
    log_info "Step 5: Initializing Git..."
    git init --quiet
    git add -A
    git commit -m "Initial commit: Laravel 12 + Livewire 4 + Tailwind 4 + daisyUI 5" --quiet
    log_success "Git initialized"

    # Step 6: Create GitHub repo
    log_info "Step 6: Creating GitHub repository..."
    if command -v gh &> /dev/null; then
        gh repo create "$project_name" --private --source=. --push
        log_success "GitHub private repo created and pushed"
    else
        log_warn "gh CLI not found. Skipping GitHub repo creation."
    fi

    # Step 7: Add blueprint-flow
    log_info "Step 7: Adding blueprint-flow..."
    _ensure_bpf_home
    cmd_init "$stack"

    # Commit blueprint-flow setup
    git add -A
    git commit -m "Add blueprint-flow with $stack stack" --quiet
    git push --quiet 2>/dev/null || true
    log_success "Blueprint setup committed"

    # Complete
    echo ""
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}  Project created successfully!${NC}"
    echo -e "${GREEN}========================================${NC}"
    echo ""
    echo -e "  Project: ${BLUE}$project_name${NC}"
    echo -e "  Path:    ${BLUE}$project_path${NC}"
    echo -e "  URL:     ${BLUE}http://${project_name}.${BPF_VALET_DOMAIN}${NC}"
    echo -e "  Stack:   ${BLUE}$stack${NC}"
    echo ""
    echo -e "  ${YELLOW}Next steps:${NC}"
    echo -e "  1. cd $project_path"
    echo -e "  2. npm run dev"
    echo -e "  3. /bpf"
    echo ""
}

_create_extension_project() {
    local project_name="$1"
    local project_path="$2"
    local stack="$3"

    log_info "Creating Chrome Extension project: $project_name"
    log_info "Path: $project_path"
    log_info "Stack: $stack"
    echo ""

    # Step 1: Scaffold with Vite react-ts template
    log_info "Step 1: Scaffolding Vite + React + TypeScript..."
    mkdir -p "$project_path"
    cd "$project_path"
    npm create vite@latest . -- --template react-ts --yes 2>/dev/null || \
        npm create vite . -- --template react-ts
    log_success "Vite project scaffolded"

    # Step 2: Install dependencies
    log_info "Step 2: Installing dependencies..."
    npm install --silent
    npm install -D \
        tailwindcss@3 postcss autoprefixer \
        daisyui@4 \
        @crxjs/vite-plugin \
        vitest \
        @testing-library/react \
        @testing-library/user-event \
        @testing-library/jest-dom \
        jsdom \
        --silent
    log_success "Dependencies installed"

    # Tailwind init
    npx tailwindcss init -p --quiet 2>/dev/null || true
    log_success "Tailwind initialized"

    # Step 3: Configure Tailwind
    log_info "Step 3: Configuring Tailwind CSS..."

    cat > tailwind.config.js << 'EOF'
import daisyui from 'daisyui'

/** @type {import('tailwindcss').Config} */
export default {
  content: [
    './src/**/*.{ts,tsx,html}',
  ],
  plugins: [daisyui],
  daisyui: {
    themes: ['light', 'dark'],
  },
}
EOF

    # Add Tailwind directives to index.css
    cat > src/index.css << 'EOF'
@tailwind base;
@tailwind components;
@tailwind utilities;
EOF
    log_success "Tailwind configured"

    # Step 4: Create manifest config
    log_info "Step 4: Creating manifest..."

    cat > manifest.config.ts << EOF
import { defineManifest } from '@crxjs/vite-plugin'

export default defineManifest({
  manifest_version: 3,
  name: '$project_name',
  version: '0.0.1',
  description: '',
  action: {
    default_popup: 'src/popup/index.html',
    default_icon: {
      '16': 'icons/icon16.png',
      '48': 'icons/icon48.png',
      '128': 'icons/icon128.png',
    },
  },
  background: {
    service_worker: 'src/background/index.ts',
    type: 'module',
  },
  content_scripts: [
    {
      matches: ['<all_urls>'],
      js: ['src/content/index.ts'],
    },
  ],
  permissions: ['storage', 'activeTab'],
  icons: {
    '16': 'icons/icon16.png',
    '48': 'icons/icon48.png',
    '128': 'icons/icon128.png',
  },
})
EOF

    # Step 5: Configure Vite with CRXJS
    log_info "Step 5: Configuring Vite..."

    cat > vite.config.ts << 'EOF'
import { defineConfig } from 'vite'
import react from '@vitejs/plugin-react'
import { crx } from '@crxjs/vite-plugin'
import manifest from './manifest.config'

export default defineConfig({
  plugins: [
    react(),
    crx({ manifest }),
  ],
})
EOF
    log_success "Vite configured with CRXJS"

    # Step 6: Create src structure
    log_info "Step 6: Creating src structure..."

    mkdir -p src/popup src/options src/background src/content src/storage src/hooks src/lib
    mkdir -p public/icons tests/unit tests/component tests/helpers

    # Popup entry
    cat > src/popup/index.html << EOF
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>$project_name</title>
</head>
<body>
  <div id="root"></div>
  <script type="module" src="./main.tsx"></script>
</body>
</html>
EOF

    cat > src/popup/main.tsx << 'EOF'
import React from 'react'
import { createRoot } from 'react-dom/client'
import '../index.css'
import { PopupApp } from './PopupApp'

createRoot(document.getElementById('root')!).render(
  <React.StrictMode>
    <PopupApp />
  </React.StrictMode>
)
EOF

    cat > src/popup/PopupApp.tsx << EOF
export function PopupApp() {
  return (
    <div className="w-[360px] min-h-[300px] p-4 bg-base-100 text-base-content">
      <h1 className="text-lg font-semibold">$project_name</h1>
    </div>
  )
}
EOF

    # Background service worker
    cat > src/background/index.ts << 'EOF'
chrome.runtime.onInstalled.addListener(() => {
  console.log('Extension installed')
})

chrome.runtime.onMessage.addListener((_msg, _sender, _sendResponse) => {
  // Handle messages from popup / content scripts
})
EOF

    # Content script
    cat > src/content/index.ts << 'EOF'
// Content script — injected into web pages
console.log('Content script loaded')
EOF

    # Storage helpers
    cat > src/storage/index.ts << 'EOF'
// Define storage schema here
export interface StorageSchema {
  settings: {
    theme: 'light' | 'dark'
  }
}

export async function getStorage<K extends keyof StorageSchema>(
  key: K
): Promise<StorageSchema[K] | undefined> {
  const result = await chrome.storage.local.get(key)
  return result[key] as StorageSchema[K] | undefined
}

export async function setStorage<K extends keyof StorageSchema>(
  key: K,
  value: StorageSchema[K]
): Promise<void> {
  await chrome.storage.local.set({ [key]: value })
}
EOF

    # Message types
    cat > src/lib/messages.ts << 'EOF'
export type ExtensionMessage =
  | { type: 'PING' }

export type ExtensionResponse =
  | { type: 'PONG' }
EOF

    # Test setup
    cat > tests/setup.ts << 'EOF'
import '@testing-library/jest-dom'

globalThis.chrome = {
  storage: {
    local: {
      get: vi.fn().mockResolvedValue({}),
      set: vi.fn().mockResolvedValue(undefined),
      onChanged: { addListener: vi.fn(), removeListener: vi.fn() },
    },
    sync: {
      get: vi.fn().mockResolvedValue({}),
      set: vi.fn().mockResolvedValue(undefined),
      onChanged: { addListener: vi.fn(), removeListener: vi.fn() },
    },
  },
  runtime: {
    sendMessage: vi.fn(),
    onMessage: { addListener: vi.fn() },
    onInstalled: { addListener: vi.fn() },
  },
  tabs: {
    query: vi.fn().mockResolvedValue([]),
  },
} as unknown as typeof chrome
EOF

    # Add vitest config to vite.config.ts
    cat > vite.config.ts << 'EOF'
import { defineConfig } from 'vite'
import react from '@vitejs/plugin-react'
import { crx } from '@crxjs/vite-plugin'
import manifest from './manifest.config'

export default defineConfig({
  plugins: [
    react(),
    crx({ manifest }),
  ],
  test: {
    globals: true,
    environment: 'jsdom',
    setupFiles: ['./tests/setup.ts'],
  },
})
EOF

    # Placeholder icons
    mkdir -p public/icons
    for size in 16 48 128; do
        touch "public/icons/icon${size}.png"
    done

    # .gitignore
    cat > .gitignore << 'EOF'
node_modules/
dist/
dist-zip/
.blueprint-flow
*.local
EOF

    log_success "src structure created"

    # Step 7: Initialize Git
    log_info "Step 7: Initializing Git..."
    git init --quiet
    git add -A
    git commit -m "Initial commit: Chrome Extension MV3 + React + TypeScript + Vite + Tailwind CSS 3" --quiet
    log_success "Git initialized"

    # Step 8: Create GitHub repo
    log_info "Step 8: Creating GitHub repository..."
    if command -v gh &> /dev/null; then
        gh repo create "$project_name" --private --source=. --push
        log_success "GitHub private repo created and pushed"
    else
        log_warn "gh CLI not found. Skipping GitHub repo creation."
    fi

    # Step 9: Add blueprint-flow
    log_info "Step 9: Adding blueprint-flow..."
    _ensure_bpf_home
    cmd_init "$stack"

    # Commit blueprint-flow setup
    git add -A
    git commit -m "Add blueprint-flow with $stack stack" --quiet
    git push --quiet 2>/dev/null || true
    log_success "Blueprint setup committed"

    # Complete
    echo ""
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}  Chrome Extension project created!${NC}"
    echo -e "${GREEN}========================================${NC}"
    echo ""
    echo -e "  Project: ${BLUE}$project_name${NC}"
    echo -e "  Path:    ${BLUE}$project_path${NC}"
    echo -e "  Stack:   ${BLUE}$stack${NC}"
    echo ""
    echo -e "  ${YELLOW}Next steps:${NC}"
    echo -e "  1. cd $project_path"
    echo -e "  2. npm run dev        (HMR with CRXJS)"
    echo -e "  3. Load dist/ in chrome://extensions (Developer mode)"
    echo -e "  4. /bpf"
    echo ""
}

_ensure_bpf_home() {
    if [[ ! -d "$BPF_HOME" ]]; then
        log_info "Cloning blueprint-flow to $BPF_HOME..."
        git clone https://github.com/tatun55/blueprint-flow "$BPF_HOME" --quiet
    else
        log_info "Using existing blueprint-flow at $BPF_HOME"
        (cd "$BPF_HOME" && git pull origin main --quiet 2>/dev/null || true)
    fi
}

cmd_pull() {
    log_info "Pulling latest blueprint-flow..."
    cd "$BPF_HOME" && git pull origin main
    log_success "Done."
}

cmd_home() {
    echo "$BPF_HOME"
}

# ============================================
# Help
# ============================================
show_help() {
    cat << EOF
Blueprint Flow v2 CLI

Usage: bpf <command> [args]

Commands:
  create-project <name>          Create new Laravel project (tall-daisy stack)
  create-project <name> --extension
                                 Create new Chrome Extension project (chrome-extension stack)
  create-project <name> --stack=<stack>
                                 Create project with specified stack
  init [stack]                   Initialize blueprint-flow in current project
  update                         Update blueprint-flow symlinks and schema
  pull                           Pull latest blueprint-flow from remote
  db init                        Initialize database + seed rules
  db reset                       Reset database + seed rules (WARNING: deletes all data)
  db seed                        Seed rules only (re-import from .md files)
  db path                        Show database path
  db migrate-v3                  Migrate v2 schema → v3 (stage model + rubric, with backup)
  ui [port]                      Launch web dashboard (default: 3141)
  home                           Show resolved BPF_HOME path

Configuration (~/.bpfrc):
  BPF_HOME=$BPF_HOME
  BPF_PROJECT_BASE=$BPF_PROJECT_BASE
  BPF_VALET_DOMAIN=$BPF_VALET_DOMAIN

  Env vars override ~/.bpfrc values.

Examples:
  bpf create-project my-todo-app
  bpf create-project my-extension --extension
  bpf create-project my-ext --extension --stack=chrome-extension
  bpf init tall-daisy
  bpf init chrome-extension
  bpf update
  bpf db reset
EOF
}

# ============================================
# Main dispatch
# ============================================
case "${1:-}" in
    create-project) cmd_create_project "${@:2}" ;;
    init)           cmd_init "${2:-tall-daisy}" ;;
    update)         cmd_update ;;
    pull)           cmd_pull ;;
    home)           cmd_home ;;
    db)
        case "${2:-}" in
            init)        db_init ;;
            reset)       db_reset ;;
            seed)        seed_rules ;;
            path)        echo "$DB_PATH" ;;
            migrate-v3)  db_migrate_v3 ;;
            *)           echo "Usage: bpf db <init|reset|seed|path|migrate-v3>"; exit 1 ;;
        esac
        ;;
    ui)
        python3 "$BPF_HOME/blueprint/ui.py" --port "${2:-3141}"
        ;;
    help|--help|-h) show_help ;;
    *)              show_help; exit 1 ;;
esac
