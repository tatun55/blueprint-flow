#!/bin/bash
# Blueprint Flow v2 CLI
# Usage: bpf <command> [args]

set -euo pipefail

# ============================================
# Configuration Resolution
# Priority: env var > ~/.bpfrc > default
# ============================================
load_config() {
    local rc="$HOME/.bpfrc"
    if [[ -f "$rc" ]]; then
        # Source only KEY=VALUE lines (ignore comments and empty lines)
        while IFS='=' read -r key value; do
            [[ -z "$key" || "$key" =~ ^# ]] && continue
            key=$(echo "$key" | tr -d '[:space:]')
            value=$(echo "$value" | tr -d '[:space:]' | sed 's/^["'"'"']//;s/["'"'"']$//')
            export "${key}=${!key:-$value}" 2>/dev/null || true
        done < "$rc"
    fi
}
load_config

BPF_HOME="${BPF_HOME:-$HOME/.blueprint-flow}"
BPF_PROJECT_BASE="${BPF_PROJECT_BASE:-$HOME/project}"
BPF_VALET_DOMAIN="${BPF_VALET_DOMAIN:-pizza}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info()    { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[OK]${NC} $1"; }
log_warn()    { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error()   { echo -e "${RED}[ERROR]${NC} $1"; }

# Check BPF_HOME exists
if [[ ! -d "$BPF_HOME" ]]; then
    log_error "Blueprint Flow not found at: $BPF_HOME"
    echo ""
    echo "Install with:"
    echo "  git clone https://github.com/tatun55/blueprint-flow ~/.blueprint-flow"
    echo ""
    echo "Or set BPF_HOME in ~/.bpfrc or as env var:"
    echo "  echo 'BPF_HOME=/path/to/blueprint-flow' >> ~/.bpfrc"
    exit 1
fi

# ============================================
# DB helpers
# ============================================
DB_PATH="blueprint/blueprint.db"
SCHEMA_PATH="blueprint/schema.sql"

get_stack() {
    if [[ -f ".blueprint-flow-stack" ]]; then
        cat ".blueprint-flow-stack"
    else
        echo ""
    fi
}

get_rules_dir() {
    local stack
    stack=$(get_stack)
    if [[ -z "$stack" ]]; then return; fi
    local dir="$BPF_HOME/.claude.$stack/rules"
    if [[ -d "$dir" ]]; then
        echo "$dir"
    fi
}

seed_rules() {
    local rules_dir
    rules_dir=$(get_rules_dir)
    if [[ -z "$rules_dir" ]]; then
        echo "No rules directory found"
        return
    fi

    local hub="python3 $BPF_HOME/blueprint/hub.py"
    local count=0
    for file in "$rules_dir"/*.md; do
        [[ -f "$file" ]] || continue
        local slug
        slug=$(basename "$file" .md)
        local name
        name=$(head -1 "$file" | sed 's/^# //')
        local summary
        summary=$(sed -n '2p' "$file" | sed 's/^> //')

        $hub upsert-core tech "rules-$slug" "$name" "$summary" < "$file" > /dev/null
        count=$((count + 1))
    done
    echo "Seeded $count rule(s) from: $rules_dir"
}

seed_knowledge_sets() {
    local mappings=(
        "page=stack,architecture,ui,data,auth,style,design-axes"
        "partial=stack,architecture,ui,data,style,design-axes"
        "action=stack,data,auth,style"
        "table=stack,db,data,style"
        "layout=stack,architecture,ui,style,design-axes"
        "test=stack,testing,style"
    )

    local count=0
    for mapping in "${mappings[@]}"; do
        local bp_type="${mapping%%=*}"
        local slugs="${mapping#*=}"
        IFS=',' read -ra slug_arr <<< "$slugs"
        for slug in "${slug_arr[@]}"; do
            sqlite3 "$DB_PATH" "INSERT OR IGNORE INTO knowledge_sets (blueprint_type, rule_slug)
                VALUES ('$bp_type', '$slug');"
            count=$((count + 1))
        done
    done
    echo "Seeded $count knowledge set mapping(s)"
}

db_migrate() {
    # Run schema migrations for existing databases
    # Each migration checks before applying (idempotent)

    # Always use latest schema from BPF_HOME
    cp "$BPF_HOME/blueprint/schema.sql" "$SCHEMA_PATH"

    # Migration 1: Add dep_gate column to dependencies
    local has_dep_gate
    has_dep_gate=$(sqlite3 "$DB_PATH" "SELECT COUNT(*) FROM pragma_table_info('dependencies') WHERE name='dep_gate';")
    if [[ "$has_dep_gate" == "0" ]]; then
        sqlite3 "$DB_PATH" "ALTER TABLE dependencies ADD COLUMN dep_gate TEXT NOT NULL DEFAULT 'done';"
        log_success "Migration: added dep_gate to dependencies"
    fi

    # Recreate VIEWs (always, to pick up any schema changes)
    sqlite3 "$DB_PATH" << 'MIGRATE_EOF'
DROP VIEW IF EXISTS app_snapshot;
DROP VIEW IF EXISTS project_progress;
DROP VIEW IF EXISTS item_status;
DROP VIEW IF EXISTS next_actions;
DROP VIEW IF EXISTS attention_needed;
DROP VIEW IF EXISTS test_coverage;
DROP VIEW IF EXISTS dependency_map;
DROP VIEW IF EXISTS task_board;
MIGRATE_EOF
    sqlite3 "$DB_PATH" < "$SCHEMA_PATH"
    log_success "VIEWs recreated"
}

db_init() {
    mkdir -p "$(dirname "$DB_PATH")"
    if [[ -f "$DB_PATH" ]]; then
        db_migrate
        echo "Database migrated: $DB_PATH"
    else
        sqlite3 "$DB_PATH" < "$SCHEMA_PATH"
        echo "Database initialized: $DB_PATH"
    fi
    seed_rules
    seed_knowledge_sets
}

db_reset() {
    rm -f "$DB_PATH"
    sqlite3 "$DB_PATH" < "$SCHEMA_PATH"
    echo "Database reset: $DB_PATH"
    seed_rules
    seed_knowledge_sets
}

# ============================================
# Symlink helpers
# ============================================
create_bpf_symlink() {
    local target_dir="${1:-.}"
    # Create .blueprint-flow symlink pointing to BPF_HOME
    if [[ -L "$target_dir/.blueprint-flow" ]]; then
        rm "$target_dir/.blueprint-flow"
    fi
    ln -sf "$BPF_HOME" "$target_dir/.blueprint-flow"
}

create_claude_symlinks() {
    local target_dir="${1:-.}"
    local stack="${2}"
    local relative_bpf=".blueprint-flow"

    # Ensure .claude is a real directory (not a symlink)
    if [[ -L "$target_dir/.claude" ]]; then
        rm "$target_dir/.claude"
    fi
    mkdir -p "$target_dir/.claude"

    for item in skills agents hooks CLAUDE.md settings.json; do
        local src="../$relative_bpf/.claude.$stack/$item"
        if [[ -e "$BPF_HOME/.claude.$stack/$item" ]]; then
            ln -sfn "$src" "$target_dir/.claude/$item"
        fi
    done
}

# ============================================
# Commands
# ============================================

cmd_init() {
    local stack="${1:-tall-daisy}"
    local target_dir="."

    log_info "Initializing blueprint-flow v2 with stack: $stack"

    # Validate stack
    if [[ ! -d "$BPF_HOME/.claude.$stack" ]]; then
        log_error "Stack '$stack' not found"
        echo "Available stacks:"
        ls -1 "$BPF_HOME" | grep "^\.claude\." | sed 's/^\.claude\./  /'
        exit 1
    fi

    # Step 1: Create .blueprint-flow symlink
    create_bpf_symlink "$target_dir"
    log_success ".blueprint-flow -> $BPF_HOME"

    # Step 2: Create .claude symlinks
    create_claude_symlinks "$target_dir" "$stack"
    log_success ".claude/ symlinks created"

    # Step 3: Create blueprint directory + copy schema
    mkdir -p "$target_dir/blueprint"
    cp "$BPF_HOME/blueprint/schema.sql" "$target_dir/blueprint/"
    log_success "Schema copied"

    # Step 4: Store stack + version
    echo "$stack" > "$target_dir/.blueprint-flow-stack"
    git -C "$BPF_HOME" rev-parse HEAD 2>/dev/null > "$target_dir/.blueprint-flow-version" || echo "dev" > "$target_dir/.blueprint-flow-version"

    # Step 5: Initialize DB
    db_init

    # Step 6: Create minimal CLAUDE.md if not exists
    if [[ ! -f "$target_dir/CLAUDE.md" ]]; then
        cat > "$target_dir/CLAUDE.md" << 'CLAUDE_EOF'
# Project Rules

## Blueprint Flow

This project uses blueprint-flow.
Core rules are defined in `.claude/CLAUDE.md` (always loaded).

Use `/bpf` for orchestration.

## Project-Specific Rules

(Add project-specific rules here)
CLAUDE_EOF
        log_success "CLAUDE.md created"
    fi

    # Add to .gitignore
    if [[ -f "$target_dir/.gitignore" ]] && ! grep -q "^\.blueprint-flow$" "$target_dir/.gitignore" 2>/dev/null; then
        echo ".blueprint-flow" >> "$target_dir/.gitignore"
        log_success "Added .blueprint-flow to .gitignore"
    fi

    echo ""
    log_success "Blueprint-flow v2 initialized!"
    echo "  Stack: $stack"
    echo "  BPF_HOME: $BPF_HOME"
}

cmd_update() {
    local target_dir="."

    if [[ ! -f "$target_dir/.blueprint-flow-stack" ]]; then
        log_error "Project not initialized. Run: bpf init [stack]"
        exit 1
    fi

    local stack
    stack=$(cat "$target_dir/.blueprint-flow-stack")
    local old_version
    old_version=$(cat "$target_dir/.blueprint-flow-version" 2>/dev/null || echo "unknown")

    log_info "Updating blueprint-flow v2..."

    # Validate stack
    if [[ ! -d "$BPF_HOME/.claude.$stack" ]]; then
        log_error "Stack '$stack' not found in $BPF_HOME"
        exit 1
    fi

    # Update .blueprint-flow symlink
    create_bpf_symlink "$target_dir"
    log_success ".blueprint-flow -> $BPF_HOME"

    # Update .claude symlinks
    create_claude_symlinks "$target_dir" "$stack"
    log_success ".claude/ symlinks updated"

    # Update schema
    cp "$BPF_HOME/blueprint/schema.sql" "$target_dir/blueprint/"
    log_success "Schema updated"

    # Update version
    local new_version
    new_version=$(git -C "$BPF_HOME" rev-parse HEAD 2>/dev/null || echo "dev")
    echo "$new_version" > "$target_dir/.blueprint-flow-version"

    echo ""
    log_success "Blueprint-flow v2 updated!"
    echo "  Old: ${old_version:0:7}"
    echo "  New: ${new_version:0:7}"
    echo ""
    echo "Note: Database preserved. If schema changed, run: bpf db reset"
}

cmd_create_project() {
    local project_name="${1:-}"
    local stack="${2:-tall-daisy}"

    if [[ -z "$project_name" ]]; then
        echo "Usage: bpf create-project <project-name> [stack]"
        exit 1
    fi

    local project_path="$BPF_PROJECT_BASE/$project_name"

    if [[ -d "$project_path" ]]; then
        log_error "Project already exists: $project_path"
        exit 1
    fi

    log_info "Creating project: $project_name"
    log_info "Path: $project_path"
    log_info "Stack: $stack"
    echo ""

    # Step 1: Create Laravel project
    log_info "Step 1: Creating Laravel project..."
    cd "$BPF_PROJECT_BASE"
    composer create-project laravel/laravel "$project_name" --quiet
    cd "$project_path"
    log_success "Laravel project created"

    # Step 2: Install dependencies
    log_info "Step 2: Installing dependencies..."
    composer require livewire/livewire --quiet
    log_success "Livewire installed"

    npm install --silent
    npm install -D tailwindcss @tailwindcss/vite daisyui --silent
    log_success "Tailwind + daisyUI installed"

    # Step 3: Configure environment
    log_info "Step 3: Configuring environment..."

    local db_pass=""
    if [[ -f ~/.my.cnf ]]; then
        db_pass=$(awk -F= '/^password/ {gsub(/"/,"",$2); print $2}' ~/.my.cnf | tr -d ' ' || echo "")
    fi

    cp .env.example .env
    sed -i '' "s|^APP_URL=.*|APP_URL=http://${project_name}.${BPF_VALET_DOMAIN}|" .env
    sed -i '' "s|^DB_CONNECTION=.*|DB_CONNECTION=mysql|" .env
    sed -i '' "s|^# DB_HOST=.*|DB_HOST=127.0.0.1|" .env
    sed -i '' "s|^# DB_PORT=.*|DB_PORT=3306|" .env
    sed -i '' "s|^# DB_DATABASE=.*|DB_DATABASE=${project_name}|" .env
    sed -i '' "s|^# DB_USERNAME=.*|DB_USERNAME=root|" .env
    sed -i '' "s|^# DB_PASSWORD=.*|DB_PASSWORD='${db_pass}'|" .env

    mysql -e "CREATE DATABASE IF NOT EXISTS \`${project_name}\`;"
    log_success "Database created: ${project_name}"

    php artisan key:generate --quiet
    log_success "App key generated"

    php artisan migrate --quiet
    log_success "Migrations completed"

    # Step 4: Configure Tailwind 4 + Vite
    log_info "Step 4: Configuring Tailwind..."

    cat > tailwind.config.js << 'EOF'
import daisyui from 'daisyui'

/** @type {import('tailwindcss').Config} */
export default {
  content: [
    "./resources/**/*.blade.php",
    "./resources/**/*.js",
    "./app/Livewire/**/*.php",
  ],
  plugins: [daisyui],
  daisyui: {
    themes: ["light", "dark"],
  },
}
EOF

    cat > resources/css/app.css << 'EOF'
@import "tailwindcss";
@config "../../tailwind.config.js";
EOF

    cat > vite.config.js << 'EOF'
import { defineConfig } from 'vite';
import laravel from 'laravel-vite-plugin';
import tailwindcss from '@tailwindcss/vite';

export default defineConfig({
    plugins: [
        laravel({
            input: ['resources/css/app.css', 'resources/js/app.js'],
            refresh: true,
        }),
        tailwindcss(),
    ],
});
EOF
    log_success "Tailwind configured"

    # Step 5: Initialize Git
    log_info "Step 5: Initializing Git..."
    git init --quiet
    git add -A
    git commit -m "Initial commit: Laravel 12 + Livewire 4 + Tailwind 4 + daisyUI 5" --quiet
    log_success "Git initialized"

    # Step 6: Create GitHub repo
    log_info "Step 6: Creating GitHub repository..."
    if command -v gh &> /dev/null; then
        gh repo create "$project_name" --private --source=. --push
        log_success "GitHub private repo created and pushed"
    else
        log_warn "gh CLI not found. Skipping GitHub repo creation."
    fi

    # Step 7: Add blueprint-flow
    log_info "Step 7: Adding blueprint-flow..."

    if [[ ! -d "$BPF_HOME" ]]; then
        log_info "Cloning blueprint-flow to $BPF_HOME..."
        git clone https://github.com/tatun55/blueprint-flow "$BPF_HOME" --quiet
    else
        log_info "Using existing blueprint-flow at $BPF_HOME"
        (cd "$BPF_HOME" && git pull origin main --quiet 2>/dev/null || true)
    fi

    cmd_init "$stack"

    # Commit blueprint-flow setup
    git add -A
    git commit -m "Add blueprint-flow with $stack stack" --quiet
    git push --quiet 2>/dev/null || true
    log_success "Blueprint setup committed"

    # Complete
    echo ""
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}  Project created successfully!${NC}"
    echo -e "${GREEN}========================================${NC}"
    echo ""
    echo -e "  Project: ${BLUE}$project_name${NC}"
    echo -e "  Path:    ${BLUE}$project_path${NC}"
    echo -e "  URL:     ${BLUE}http://${project_name}.${BPF_VALET_DOMAIN}${NC}"
    echo -e "  Stack:   ${BLUE}$stack${NC}"
    echo ""
    echo -e "  ${YELLOW}Next steps:${NC}"
    echo -e "  1. cd $project_path"
    echo -e "  2. npm run dev"
    echo -e "  3. /bpf"
    echo ""
}

cmd_pull() {
    log_info "Pulling latest blueprint-flow..."
    cd "$BPF_HOME" && git pull origin main
    log_success "Done."
}

cmd_home() {
    echo "$BPF_HOME"
}

# ============================================
# Help
# ============================================
show_help() {
    cat << EOF
Blueprint Flow v2 CLI

Usage: bpf <command> [args]

Commands:
  create-project <name> [stack]  Create new Laravel project with full setup
  init [stack]                   Initialize blueprint-flow in current project
  update                         Update blueprint-flow symlinks and schema
  pull                           Pull latest blueprint-flow from remote
  db init                        Initialize database + seed rules
  db reset                       Reset database + seed rules (WARNING: deletes all data)
  db seed                        Seed rules only (re-import from .md files)
  db path                        Show database path
  ui [port]                      Launch web dashboard (default: 3141)
  home                           Show resolved BPF_HOME path

Configuration (~/.bpfrc):
  BPF_HOME=$BPF_HOME
  BPF_PROJECT_BASE=$BPF_PROJECT_BASE
  BPF_VALET_DOMAIN=$BPF_VALET_DOMAIN

  Env vars override ~/.bpfrc values.

Examples:
  bpf create-project my-todo-app
  bpf init tall-daisy
  bpf update
  bpf db reset
EOF
}

# ============================================
# Main dispatch
# ============================================
case "${1:-}" in
    create-project) cmd_create_project "${2:-}" "${3:-tall-daisy}" ;;
    init)           cmd_init "${2:-tall-daisy}" ;;
    update)         cmd_update ;;
    pull)           cmd_pull ;;
    home)           cmd_home ;;
    db)
        case "${2:-}" in
            init)  db_init ;;
            reset) db_reset ;;
            seed)  seed_rules; seed_knowledge_sets ;;
            path)  echo "$DB_PATH" ;;
            *)     echo "Usage: bpf db <init|reset|seed|path>"; exit 1 ;;
        esac
        ;;
    ui)
        python3 "$BPF_HOME/blueprint/ui.py" --port "${2:-3141}"
        ;;
    help|--help|-h) show_help ;;
    *)              show_help; exit 1 ;;
esac
