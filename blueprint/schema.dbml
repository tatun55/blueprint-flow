// Blueprint Schema - Spec Management with Review Workflow
// Database: SQLite

Table specs {
  id integer [pk, increment]
  category text [not null, note: 'core, data, ui, action']
  type text [not null, note: 'overview, const, tables, seeders, pages, partials, layouts, sync, async, scheduled']
  slug text [not null]
  name text [not null]
  description text

  // Status workflow
  status text [default: 'draft', note: 'draft, pending_review, approved, in_progress, impl_review, testing, done, needs_revision']

  // Work assignment
  working_by text [note: 'Agent/worker currently assigned']

  // Review tracking
  human_reviewed boolean [default: false]
  revision_count integer [default: 0]
  revision_reason text

  // E2E testing
  e2e_status text [default: null, note: 'null=N/A, pending, passed, failed']
  e2e_level integer [default: 1, note: 'Required test level 1-3']

  // Ordering
  wave integer [default: 1, note: 'Execution order for dependencies']

  // Spec data
  data json [not null]

  // Timestamps
  created_at datetime [default: `CURRENT_TIMESTAMP`]
  updated_at datetime [default: `CURRENT_TIMESTAMP`]

  indexes {
    (category, type, slug) [unique]
    (category, type)
    status
    wave
    working_by
    e2e_status
  }
}

Table tasks {
  id integer [pk, increment]
  spec_id integer [ref: > specs.id]
  agent_type text [not null, note: 'db-architect, livewire, artisan, tester']
  content text [not null, note: 'Task instruction content']
  status text [default: 'pending', note: 'pending, completed, failed']
  created_at datetime [default: `CURRENT_TIMESTAMP`]

  indexes {
    spec_id
    status
  }
}

// Views (defined in schema.sql)
// - available_specs: status=approved, not locked
// - in_progress_specs: status=in_progress
// - pending_review_specs: status=pending_review or impl_review
// - needs_attention_specs: status=needs_revision
// - e2e_pending_specs: e2e_status=pending
